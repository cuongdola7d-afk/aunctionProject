                  <Label text="Nếu ấn vào đây tài khoản của bạn sẽ bị xoá vĩnh viễn" />
               </children>
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </VBox>
            <Button fx:id="btnDeleteAccount" alignment="CENTER" mnemonicParsing="false" onAction="#handleDeleteAccount" prefHeight="30.0" prefWidth="60.0" style="-fx-background-color: #9e0000;" text="Xoá" textFill="WHITE">
               <HBox.margin>
                  <Insets right="-40.0" />
               </HBox.margin>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
         </children>
      </HBox>
      <VBox alignment="CENTER" prefHeight="150.0" prefWidth="100.0" style="-fx-border-radius: 10; -fx-border-color: black; -fx-background-color: cyan; -fx-background-radius: 10;" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="60.0">
