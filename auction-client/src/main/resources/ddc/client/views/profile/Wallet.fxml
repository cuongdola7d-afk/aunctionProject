<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="walletContainer" alignment="CENTER" prefHeight="320.0" prefWidth="320.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #d9e2ef; -fx-border-radius: 12;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ddc.client.controller.profile.Wallet">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <VBox fx:id="walletView" alignment="CENTER" spacing="12.0">
         <children>
            <Label style="-fx-font-weight: bold; -fx-text-fill: #001f3f;" text="Ví của tôi">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <Label style="-fx-text-fill: #666666;" text="Số dư hiện tại">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            <Label fx:id="balanceLabel" style="-fx-font-weight: bold; -fx-text-fill: darkblue;" text="0 VND">
               <font>
                  <Font size="28.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="depositButton" mnemonicParsing="false" onAction="#handleDeposit" prefWidth="120.0" style="-fx-background-color: darkblue; -fx-text-fill: white; -fx-background-radius: 8;" text="Nạp tiền" />
                  <Button mnemonicParsing="false" onAction="#handleClose" prefWidth="120.0" style="-fx-background-radius: 8;" text="Đóng" />
               </children>
            </HBox>
         </children>
      </VBox>

      <VBox fx:id="depositView" alignment="CENTER" managed="false" spacing="12.0" visible="false">
         <children>
            <Label style="-fx-font-weight: bold; -fx-text-fill: #001f3f;" text="Ví của tôi">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <Label fx:id="currentBalanceLabel" style="-fx-text-fill: #666666;" text="Số dư hiện tại: 0 VND">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            <Label style="-fx-text-fill: #666666;" text="Nhập số tiền cần nạp">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            <TextField fx:id="depositAmountField" maxWidth="240.0" promptText="100000" style="-fx-background-radius: 8; -fx-border-radius: 8;" />
            <Label style="-fx-text-fill: #666666;" text="Hoặc chọn nhanh:">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" spacing="8.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleQuickAmount" prefWidth="62.0" style="-fx-background-radius: 8;" text="50.000" />
                  <Button mnemonicParsing="false" onAction="#handleQuickAmount" prefWidth="62.0" style="-fx-background-radius: 8;" text="100.000" />
                  <Button mnemonicParsing="false" onAction="#handleQuickAmount" prefWidth="62.0" style="-fx-background-radius: 8;" text="200.000" />
                  <Button mnemonicParsing="false" onAction="#handleQuickAmount" prefWidth="62.0" style="-fx-background-radius: 8;" text="500.000" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleBackToWallet" prefWidth="110.0" style="-fx-background-radius: 8;" text="Quay lại" />
                  <Button fx:id="confirmDepositButton" mnemonicParsing="false" onAction="#handleConfirmDeposit" prefWidth="120.0" style="-fx-background-color: darkblue; -fx-text-fill: white; -fx-background-radius: 8;" text="Xác nhận nạp" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
