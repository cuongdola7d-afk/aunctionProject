<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ddc.client.controller.bidding.BiddingDemoController"
            prefWidth="1000.0"
            prefHeight="650.0">

    <children>
        <VBox spacing="20.0"
              AnchorPane.topAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0"
              AnchorPane.bottomAnchor="20.0">

            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <children>
                <Label text="BIDDING DEMO" styleClass="title-label"/>

                <HBox spacing="20.0">
                    <children>
                        <VBox spacing="12.0" prefWidth="420.0" styleClass="info-card">
                            <children>
                                <Label text="Thông tin sản phẩm" styleClass="section-title"/>
                                <Label fx:id="lblItemName" text="Tên sản phẩm"/>
                                <Label text="Mô tả: Laptop hiệu năng cao, phù hợp học tập và gaming"/>
                                <Label fx:id="lblCurrentPrice" text="Giá hiện tại"/>
                                <Label fx:id="lblHighestBidder" text="Người dẫn đầu"/>
                                <Label fx:id="lblTimeLeft" text="Thời gian còn lại"/>
                            </children>
                        </VBox>

                        <VBox spacing="12.0" prefWidth="420.0" styleClass="bid-card">
                            <children>
                                <Label text="Đặt giá" styleClass="section-title"/>
                                <TextField fx:id="txtBidAmount" promptText="Nhập giá bid của bạn"/>
                                <Button text="Place Bid"
                                        onAction="#handlePlaceBid"
                                        styleClass="bid-button"/>
                                <Label fx:id="lblMessage" text="Thông báo hệ thống"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="10.0" styleClass="history-card">
                    <children>
                        <Label text="Lịch sử đấu giá" styleClass="section-title"/>
                        <TableView fx:id="tableBidHistory" prefHeight="300.0">
                            <columns>
                                <TableColumn fx:id="colBidder" text="Bidder" prefWidth="250.0"/>
                                <TableColumn fx:id="colAmount" text="Bid Amount" prefWidth="250.0"/>
                                <TableColumn fx:id="colTime" text="Bid Time" prefWidth="300.0"/>
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>