<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ddc.client.controller.bidding.AuctionDetail">
   <children>
      <HBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            
            <VBox spacing="10.0" HBox.hgrow="ALWAYS" alignment="TOP_CENTER">
               <children>
                  <StackPane style="-fx-border-color: #eeeeee; -fx-border-width: 1;">
                     <children>
                        <ImageView fx:id="mainImage" fitHeight="450.0" fitWidth="550.0" preserveRatio="true" />
                     </children>
                  </StackPane>
                  
                  <FlowPane fx:id="thumbnailContainer" hgap="10.0" vgap="10.0" alignment="CENTER">
                     <padding>
                        <Insets top="10.0" />
                     </padding>
                  </FlowPane>
               </children>
            </VBox>

 <VBox prefWidth="420.0" spacing="15.0" style="-fx-padding: 0 10 0 20; -fx-border-color: #eeeeee; -fx-border-width: 0 0 0 1;">
   <children>
      <Label text="Thông tin phiên đấu giá" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
      
      <VBox spacing="5.0" style="-fx-background-color: #fdf2f2; -fx-padding: 10; -fx-border-color: #f5c6cb; -fx-border-radius: 5;">
         <children>
            <Label text="Thời gian còn lại để đăng ký:" textFill="#721c24" />
            <Label fx:id="lblCountdown" text="03 Ngày 15 : 43 : 02" style="-fx-font-size: 20; -fx-font-weight: bold;" textFill="#b22222" />
         </children>
      </VBox>

      <GridPane vgap="12.0" hgap="10.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" />
          <ColumnConstraints hgrow="ALWAYS" halignment="RIGHT" />
        </columnConstraints>
        <children>
            <Label text="Thời gian bắt đầu:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" />
            <Label fx:id="lblStartTime" text="09/04/2026 09:00:00" textFill="#28a745" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Thời gian kết thúc:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" />
            <Label fx:id="lblEndTime" text="09/04/2026 09:30:00" textFill="#dc3545" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Separator GridPane.columnSpan="2" GridPane.rowIndex="2" />

            <Label text="Giá khởi điểm:" style="-fx-font-weight: bold;" GridPane.rowIndex="3" />
            <Label fx:id="lblPrice" text="71.000.000 VNĐ" textFill="#b22222" style="-fx-font-size: 16; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label text="Mã tài sản:" GridPane.rowIndex="4" />
            <Label text="MTS-TSUMOA" GridPane.columnIndex="1" GridPane.rowIndex="4" />

            <Label text="Tiền đặt trước:" GridPane.rowIndex="5" />
            <Label text="14.200.000 VNĐ" GridPane.columnIndex="1" GridPane.rowIndex="5" />

            <Label text="Bước giá:" GridPane.rowIndex="6" />
            <Label text="1.000.000 VNĐ" GridPane.columnIndex="1" GridPane.rowIndex="6" />
        </children>
      </GridPane>

      <Region VBox.vgrow="ALWAYS" />

      <Button maxWidth="Infinity" prefHeight="50.0" text="ĐĂNG KÝ THAM GIA" 
              style="-fx-background-color: #b22222; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
   </children>
</VBox> 
         </children>
      </HBox>
   </children>
</AnchorPane>