<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ddc.client.controller.bidding.AuctionDetail"
            prefWidth="1200.0"
            prefHeight="760.0"
            style="-fx-background-color: #0f172a;">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="12.0"
              prefHeight="64.0"
              style="-fx-background-color: #111827; -fx-padding: 14 20 14 20;">

            <Label text="← Quay lại"
                   onMouseClicked="#handleBackToBidding"
                   style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand;" />

            <Label text="Chi tiết phiên đấu giá"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    pannable="true"
                    style="-fx-background: #0f172a; -fx-background-color: #0f172a;">
            <content>
                <VBox spacing="20.0"
                      style="-fx-background-color: #0f172a; -fx-padding: 24;">

                    <HBox spacing="24.0" alignment="TOP_LEFT">

                        <!-- Cột trái: ảnh -->
                        <VBox spacing="16.0"
                              prefWidth="700.0"
                              style="-fx-background-color: #111827; -fx-background-radius: 18; -fx-padding: 18;">

                            <StackPane prefWidth="660.0"
                                       prefHeight="420.0"
                                       style="-fx-background-color: #1f2937; -fx-background-radius: 16;">
                                <ImageView fx:id="mainImage"
                                           fitWidth="620.0"
                                           fitHeight="380.0"
                                           preserveRatio="true"
                                           pickOnBounds="true" />
                            </StackPane>

                            <Label text="Ảnh xem thêm"
                                   style="-fx-text-fill: #e5e7eb; -fx-font-size: 15px; -fx-font-weight: bold;" />

                            <FlowPane fx:id="thumbnailContainer"
                                      hgap="10.0"
                                      vgap="10.0"
                                      prefWrapLength="620.0"
                                      style="-fx-background-color: #0b1220; -fx-background-radius: 12; -fx-padding: 12;" />
                        </VBox>

                        <!-- Cột phải: thông tin đấu giá -->
                        <VBox spacing="16.0"
                              prefWidth="420.0"
                              style="-fx-background-color: #111827; -fx-background-radius: 18; -fx-padding: 20;">

                            <Label text="Thông tin đấu giá"
                                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />

                            <Separator />

                            <VBox spacing="10.0"
                                  style="-fx-background-color: #0b1220; -fx-background-radius: 14; -fx-padding: 16;">

                                <Label text="Giá hiện tại"
                                       style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;" />

                                <Label fx:id="lblPrice"
                                       text="0 đ"
                                       style="-fx-text-fill: #22c55e; -fx-font-size: 28px; -fx-font-weight: bold;" />

                                <Label text="Đếm ngược"
                                       style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;" />

                                <Label fx:id="lblCountdown"
                                       text="00:00:00"
                                       style="-fx-text-fill: #f8fafc; -fx-font-size: 20px; -fx-font-weight: bold;" />
                            </VBox>

                            <HBox spacing="12.0">
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #0b1220; -fx-background-radius: 14; -fx-padding: 14;">
                                    <Label text="Bắt đầu"
                                           style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;" />
                                    <Label fx:id="lblStartTime"
                                           text="--/--/---- --:--"
                                           style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" />
                                </VBox>

                                <VBox spacing="6.0" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #0b1220; -fx-background-radius: 14; -fx-padding: 14;">
                                    <Label text="Kết thúc"
                                           style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;" />
                                    <Label fx:id="lblEndTime"
                                           text="--/--/---- --:--"
                                           style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" />
                                </VBox>
                            </HBox>

                            <VBox spacing="10.0"
                                  style="-fx-background-color: #0b1220; -fx-background-radius: 14; -fx-padding: 16;">

                                <Label text="Nhập giá ra"
                                       style="-fx-text-fill: #e5e7eb; -fx-font-size: 15px; -fx-font-weight: bold;" />

                                <TextField fx:id="txtBidAmount"
                                           promptText="Ví dụ: 180000"
                                           style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 10; -fx-font-size: 14px;"
                                           prefHeight="42.0" />

                                <Button text="Ra giá"
                                        onAction="#handlePlaceBid"
                                        prefHeight="42.0"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: #06b6d4; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;" />
                            </VBox>

                            <VBox spacing="8.0"
                                  style="-fx-background-color: #0b1220; -fx-background-radius: 14; -fx-padding: 14;">

                                <Label text="Trạng thái / thông báo"
                                       style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;" />

                                <Label fx:id="lblMessage"
                                       text="Chưa có cập nhật."
                                       wrapText="true"
                                       style="-fx-text-fill: #f8fafc; -fx-font-size: 14px;" />
                            </VBox>

                            <Region VBox.vgrow="ALWAYS" />
                        </VBox>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>