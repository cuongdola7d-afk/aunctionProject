<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="cardRoot"
      alignment="CENTER_LEFT"
      onMouseClicked="#handleCardClick"
      prefHeight="178.0"
      prefWidth="430.0"
      spacing="16.0"
      style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-color: #d1d5db; -fx-border-radius: 18; -fx-cursor: hand;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ddc.client.controller.bidding.AuctionCard">

    <children>
        <!-- Ảnh sản phẩm -->
        <ImageView fx:id="imgItem"
                   fitHeight="120.0"
                   fitWidth="120.0"
                   pickOnBounds="true"
                   preserveRatio="true">
            <HBox.margin>
                <Insets left="16.0" />
            </HBox.margin>
        </ImageView>

        <!-- Nội dung chính -->
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <children>
                <Label fx:id="lblName"
                       maxWidth="230.0"
                       text="Tên sản phẩm"
                       wrapText="true"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />

                <Label fx:id="lblCategory"
                       text="Danh mục"
                       style="-fx-background-color: #dbeafe; -fx-background-radius: 999; -fx-text-fill: #1d4ed8; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 4 12 4 12;" />

                <Label fx:id="lblPrice"
                       text="1,250,000 đ"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #dc2626;" />

                <Label fx:id="lblTimeLeft"
                       text="◷ 02:15:30"
                       style="-fx-font-size: 13px; -fx-text-fill: #334155;" />
            </children>
        </VBox>

        <!-- Nút -->
        <VBox alignment="CENTER" spacing="10.0">
            <children>
                <Button mnemonicParsing="false"
                        onMouseClicked="#handleCardClick"
                        prefHeight="42.0"
                        prefWidth="130.0"
                        text="Xem chi tiết"
                        style="-fx-background-color: #0b1a44; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 14;" />
                <Region prefHeight="1.0" prefWidth="1.0" />
            </children>
            <HBox.margin>
                <Insets right="16.0" />
            </HBox.margin>
        </VBox>
    </children>

    <padding>
        <Insets top="16.0" right="0.0" bottom="16.0" left="0.0" />
    </padding>
</HBox>