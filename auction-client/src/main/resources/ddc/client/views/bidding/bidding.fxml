<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ddc.client.controller.bidding.Bidding"
            prefWidth="800"
            prefHeight="600"
            styleClass="root-container">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>

            <Label text="DDC Auction logo" styleClass="logo-text"/>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="txtSearch"
                       prefWidth="670"
                       promptText="Tìm kiếm sản phẩm đấu giá..."
                       styleClass="search-box"/>
        </HBox>
    </top>

    <left>
        <VBox alignment="CENTER" spacing="18" prefWidth="55" styleClass="left-dots-bar">
            <Label text="●" styleClass="dot-indicator"/>
            <Label text="●" styleClass="dot-indicator"/>
            <Label text="●" styleClass="dot-indicator"/>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="content-wrapper">
            <ScrollPane fx:id="mainScrollPane"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        styleClass="main-scroll">
                <content>
                    <FlowPane fx:id="auctionContainer"
                              hgap="24"
                              vgap="28"
                              prefWrapLength="1000"
                              styleClass="auction-grid">
                        <padding>
                            <Insets top="20" right="24" bottom="20" left="24"/>
                        </padding>
                    </FlowPane>
                </content>
            </ScrollPane>

            <Button text="↑"
                    onAction="#handleScrollTop"
                    styleClass="scroll-top-button"
                    StackPane.alignment="BOTTOM_RIGHT"
                    translateX="-18"
                    translateY="-18"/>
        </StackPane>
    </center>

<bottom>
    <HBox alignment="CENTER"
          minHeight="0.0"
          prefHeight="60.0"
          prefWidth="550.0"
          spacing="15.0"
          style="-fx-background-color: cyan; -fx-min-height: 70; -fx-padding: 10;">
        <children>
            <VBox alignment="CENTER" prefHeight="60.0" prefWidth="120.0" HBox.hgrow="ALWAYS">
                <children>
                    <Label text="🔔" textFill="DARKBLUE">
                        <VBox.margin>
                            <Insets top="10.0" />
                        </VBox.margin>
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
                    <Label alignment="CENTER" prefHeight="45.0" text="THÔNG BÁO" textFill="DARKBLUE">
                        <font>
                            <Font name="Roboto" size="13.0" />
                        </font>
                    </Label>
                </children>
                <padding>
                    <Insets bottom="5.0" />
                </padding>
            </VBox>

            <Separator orientation="VERTICAL" prefHeight="200.0" />

            <VBox alignment="CENTER"
                  prefHeight="60.0"
                  prefWidth="120.0"
                  style="-fx-background-color: #001F3F; -fx-background-radius: 15; -fx-padding: 10 20 10 20;"
                  HBox.hgrow="ALWAYS">
                <children>
                    <Label text="⚖" textFill="AQUA">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
                    <Label alignment="CENTER" prefHeight="45.0" prefWidth="89.0" text="ĐẤU GIÁ" textFill="AQUA">
                        <font>
                            <Font name="Roboto" size="13.0" />
                        </font>
                    </Label>
                </children>
                <padding>
                    <Insets bottom="5.0" />
                </padding>
            </VBox>

            <Separator orientation="VERTICAL" prefHeight="200.0" />

            <VBox alignment="CENTER" prefHeight="60.0" prefWidth="120.0" onMouseClicked="#toHome" HBox.hgrow="ALWAYS">
                <children>
                    <Label text="🏠" textFill="DARKBLUE">
                        <VBox.margin>
                            <Insets top="10.0" />
                        </VBox.margin>
                    </Label>
                    <Label alignment="CENTER" prefHeight="45.0" text="TRANG CHỦ" textFill="DARKBLUE">
                        <font>
                            <Font name="Roboto" size="13.0" />
                        </font>
                    </Label>
                </children>
                <padding>
                    <Insets bottom="5.0" />
                </padding>
            </VBox>

            <Separator orientation="VERTICAL" prefHeight="200.0" />

            <VBox alignment="CENTER" prefHeight="60.0" prefWidth="120.0" onMouseClicked="#toSelling" HBox.hgrow="ALWAYS">
                <children>
                    <Label text="💵" textFill="DARKBLUE">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
                    <Label alignment="CENTER" prefHeight="45.0" prefWidth="89.0" text="ĐĂNG BÁN" textFill="DARKBLUE">
                        <font>
                            <Font name="Roboto" size="13.0" />
                        </font>
                    </Label>
                </children>
                <padding>
                    <Insets bottom="5.0" />
                </padding>
            </VBox>

            <Separator orientation="VERTICAL" prefHeight="200.0" />

            <VBox alignment="CENTER" prefHeight="60.0" prefWidth="120.0" HBox.hgrow="ALWAYS">
                <children>
                    <Label text="👤" textFill="DARKBLUE">
                        <VBox.margin>
                            <Insets top="10.0" />
                        </VBox.margin>
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
                    <Label alignment="CENTER" prefHeight="45.0" text="THÔNG TIN" textFill="DARKBLUE">
                        <font>
                            <Font name="Roboto" size="13.0" />
                        </font>
                    </Label>
                </children>
                <padding>
                    <Insets bottom="5.0" />
                </padding>
            </VBox>
        </children>
    </HBox>
</bottom>
</BorderPane>